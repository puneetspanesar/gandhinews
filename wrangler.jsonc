{
  "name": "gandhinews",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "SITE_URL": "https://gandhinews.com",
    "AWS_REGION": "ap-south-1",
    "MAIL_FROM_ADDRESS": "brief@lokvox.com"
  },
  "d1_databases": [{ "binding": "DB", "database_name": "lokvox-subscribers", "database_id": "6b088a99-6771-4d69-bc2f-06a764cc16c7" }],
  // Cloudflare Email Service: sends the confirmation emails from brief@lokvox.com.
  "send_email": [{ "name": "EMAIL", "remote": true }]
}
