{
  "name": "gandhinews",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "SITE_URL": "https://lokvox.com",
    "AWS_REGION": "ap-south-1",
    "MAIL_FROM_ADDRESS": "brief@lokvox.com"
  }
  // Added once set up in the Cloudflare dashboard (adding them earlier would fail the deploy):
  // "d1_databases": [{ "binding": "DB", "database_name": "lokvox-subscribers", "database_id": "<id>" }],
  // "send_email": [{ "name": "EMAIL", "remote": true }]
}
