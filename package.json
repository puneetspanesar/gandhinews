{
  "name": "lokvox",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/schema-crops.mjs && astro build && pagefind --site dist && node scripts/check-links.mjs && node scripts/gate.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "clean": "rm -rf .astro node_modules/.astro dist",
    "check:links": "node scripts/check-links.mjs",
    "check:photos": "node scripts/check-photos.mjs",
    "indexnow": "NODE_USE_ENV_PROXY=1 NODE_EXTRA_CA_CERTS=${NODE_EXTRA_CA_CERTS:-/root/.ccr/ca-bundle.crt} node scripts/indexnow.mjs",
    "build:fast": "node scripts/schema-crops.mjs && astro build && pagefind --site dist"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.8",
    "aws4fetch": "^1.0.20",
    "pagefind": "^1.5.2",
    "sharp": "^0.34.5",
    "unist-util-visit": "^5.1.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
