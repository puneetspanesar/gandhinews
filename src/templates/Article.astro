---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Photo from '../components/Photo.astro';
import PfMeta from '../components/PfMeta.astro';
import FormatLabel from '../components/FormatLabel.astro';
import Byline from '../components/Byline.astro';
import Sources from '../components/Sources.astro';
import Tags from '../components/Tags.astro';
import RailList from '../components/RailList.astro';
import FollowCard from '../components/FollowCard.astro';
import { content, urlOf, prefix, kicker, fmtDate, fmtDateTime, labelParts, heroOf, emph } from '../lib/site';
import { UI, SECTION_NAMES, HUBS, TYPE_HUB, verdictKey, VERDICT_ORDER, type Lang } from '../lib/i18n';
import PHOTO_MAP from '../../content/photos.map.json';
import CORRECTIONS from '../../content/corrections.json';
import { newsArticleLd, faqLd, claimReviewLd, storyImage, shareImage } from '../lib/seo';
import { stateBox } from '../lib/home';
import { duo } from '../lib/icons.mjs';
import '../styles/article-c.css';

interface Props { lang: Lang; id: string; route: string }
const { lang, id, route } = Astro.props;
const c = (await content())[lang];
const e = c.all.get(id)!;
const d: any = e.data;
const t = UI[lang];
const p = prefix(lang);
const html: string = (e as any).rendered?.html ?? '';
const headings: any[] = (e as any).rendered?.metadata?.headings ?? [];
const k = kicker(d);

// Breadcrumbs: Home > Section (news) or format hub > short label
const hubKey = TYPE_HUB[d.type];
const second = d.type === 'news'
  ? { name: SECTION_NAMES[lang][d.section], href: `${p}/${d.section}/` }
  : { name: HUBS[hubKey][lang], href: `${p}/${hubKey}/` };
const crumbs = [{ name: t.home, href: `${p}/` }, second, { name: d.title, href: route }];

// Rail content
const topicPages = d.topics.map((x: string) => c.all.get(x)).filter((x: any) => x && x.data.type === 'topic');
const related0 = d.related.map((r: string) => c.all.get(r)).filter((x: any) => x && x.data.id !== d.id && x.data.type !== 'topic');
// Never an empty rail: top up with the newest stories from the same section (then any section) published before this one.
const near = (x: any) => x.data.id !== d.id && x.data.type === 'news' && !related0.includes(x) && +x.data.published <= +d.published + 6 * 3.6e6;
const related = related0.length >= 3 ? related0 : [...related0, ...c.articles.filter((x: any) => near(x) && x.data.section === d.section), ...c.articles.filter((x: any) => near(x) && x.data.section !== d.section)].filter((x: any, i: number, a: any[]) => a.indexOf(x) === i).slice(0, 5);
const relatedIds = new Set([d.id, ...related.map((x: any) => x.data.id)]);
const sharesTopic = (x: any) => x.data.topics.some((tp: string) => d.topics.includes(tp));
const startHere = c.articles.filter((x: any) => x.data.type === 'explainer' && !relatedIds.has(x.data.id) && sharesTopic(x)).slice(0, 3);
const sameType = (type: string) => c.articles.filter((x: any) => x.data.type === type && x.data.id !== d.id && !relatedIds.has(x.data.id));

// Structured data
const jsonld: any[] = [];
if (d.type === 'factcheck') jsonld.push(claimReviewLd(d));
else jsonld.push(newsArticleLd(d));
if (d.type === 'explainer') { const f = faqLd(d, html); if (f) jsonld.push(f); }

const toc = d.type === 'explainer' ? headings.filter((h) => h.depth === 2) : [];
const vkey = d.factcheck ? verdictKey(d.factcheck.verdict) : null;
const vIcon = vkey === 'false' ? 'x-circle' : vkey === 'misleading' ? 'warning-circle' : 'check-circle';
const firstSeen = d.factcheck?.firstSeen instanceof Date ? d.factcheck.firstSeen : null;
const fmtD = (x: Date) => fmtDateTime(x, lang).split(',').slice(0, lang === 'hi' ? 1 : 2).join(',');
const active = d.type === 'news' ? d.section : hubKey;
const hero = heroOf(d);
const hasCover = !!(PHOTO_MAP as any)[d.id]?.cover;
// Photo treatment: a bottom gradient carrying the story's key fact. Uses hero.overlay from the
// story file if set, otherwise the highlighted phrase of the first key point.
const firstKey = (d.keyPoints?.[0] ?? '').match(/\*\*(.+?)\*\*/)?.[1] ?? '';
const cap = (x: string) => (x ? x.charAt(0).toUpperCase() + x.slice(1) : x);
// ---- Story page design C (owner's pick, November 9): split opening (tinted panel + photo), a strip of key numbers,
// key points in a 2x2 grid, the story's timeline set in the text, and a "Where" map in the rail.
const all = await content();
const enD: any = all.en.all.get(id)?.data ?? d;
const pm: any = (PHOTO_MAP as any)[d.id];
const split = (d.type === 'news' || d.type === 'editorial') && !!pm && !pm.graphic && !pm.nohome;
const ig: any = (d as any).infographic ?? {};
const glanceAll: any[] = ((d as any).glance ?? ig.stats ?? []).filter((x: any) => x && x.value && x.label);
const glance = split && glanceAll.length >= 3 ? glanceAll.slice(0, 4) : [];
const MON: Record<string, string> = { Jan: 'January', Feb: 'February', Mar: 'March', Apr: 'April', Jun: 'June', Jul: 'July', Aug: 'August', Sep: 'September', Sept: 'September', Oct: 'October', Nov: 'November', Dec: 'December' };
const fullMonth = (x: string) => String(x).replace(/\b(Jan|Feb|Mar|Apr|Jun|Jul|Aug|Sept?|Oct|Nov|Dec)\b\.?/g, (m, a) => MON[a] ?? m);   // owner: dates as "November 7"
const tlAll: any[] = (ig.timeline ?? ig.steps ?? []).map((x: any) => ({ date: fullMonth(x.date ?? x.title), text: x.text })).filter((x: any) => x.date && x.text);
const tl = split && tlAll.length >= 2 ? tlAll.slice(0, 4) : [];
const ALIAS: Record<string, string> = { 'New Delhi': 'Delhi', Mumbai: 'Maharashtra', Bengaluru: 'Karnataka', Kolkata: 'West Bengal', Chennai: 'Tamil Nadu', Hyderabad: 'Telangana', Lucknow: 'Uttar Pradesh', Srinagar: 'Jammu and Kashmir', Ladakh: 'Jammu and Kashmir', Leh: 'Jammu and Kashmir', Jammu: 'Jammu and Kashmir', Gurugram: 'Haryana', Noida: 'Uttar Pradesh', Ahmedabad: 'Gujarat', Patna: 'Bihar', Bhopal: 'Madhya Pradesh', Jaipur: 'Rajasthan', Raipur: 'Chhattisgarh', Ranchi: 'Jharkhand', Bhubaneswar: 'Odisha', Thiruvananthapuram: 'Kerala', Guwahati: 'Assam', Dehradun: 'Uttarakhand', Shimla: 'Himachal Pradesh', Chandigarh: 'Chandigarh', Amaravati: 'Andhra Pradesh', Panaji: 'Goa', Imphal: 'Manipur', Agartala: 'Tripura', Shillong: 'Meghalaya', Aizawl: 'Mizoram', Kohima: 'Nagaland', Itanagar: 'Arunachal Pradesh', Gangtok: 'Sikkim', Puducherry: 'Puducherry' };
const locParts = String(enD.location ?? '').split(',').map((x) => x.trim()).filter(Boolean);
const stName = locParts.map((x) => ALIAS[x] ?? x).reverse().find((x) => stateBox(x));
const where = d.type === 'news' && stName ? { shape: stateBox(stName)!, place: d.location } : null;
const heroOv = {
  kicker: d.hero?.overlay?.kicker ?? (d.type === 'editorial' ? (lang === 'hi' ? 'हमारा मत' : 'Our view') : String(d.format_label || '').replace(/\s*\/\s*/g, ' · ')),
  value: d.hero?.overlay?.value ?? cap(firstKey),
};
---
<Base
  lang={lang}
  noindex={d.verification?.status === 'needs-editor-approval'}
  title={d.title}
  description={d.seo.description}
  path={route}
  ogType="article"
  image={shareImage(d)}
  jsonld={jsonld}
  crumbs={crumbs}
  active={active}
  article={{ published: d.published, modified: d.updated ?? d.published, section: labelParts(d.format_label)[0], tags: d.topics }}
>
  {split && (
    <div class="ac-top" data-pagefind-body>
      <div class="ac-tx">
        <FormatLabel data={d} />
        <h1>{d.title}</h1>
        <p class="stand">{d.standfirst}</p>
        <Byline lang={lang} published={d.published} updated={d.updated} title={d.title} path={route} kicker={k} location={d.type === 'news' ? d.location : null} />
      </div>
      <figure class="ac-ph">
        <Photo id={d.id} src={d.hero?.src} alt={hero.alt} size="lg" lang={lang} eager />
        {hero.src && (hero.caption || hero.credit) && <figcaption><span>{hero.caption}</span> {hero.page ? <a class="pcred" href={`/photo-credits/#${hero.photoId}`}>{hero.short}</a> : <span class="pcred">{hero.credit}</span>}</figcaption>}
      </figure>
    </div>
  )}
  {glance.length > 0 && (
    <div class="ac-band"><div class={`w ac-strip n${glance.length}`}>{glance.map((x: any) => <p><Icon name={duo(x.icon, 'chart-bar-duotone')} class="ic" /><span><b>{x.value}</b> {x.label}</span></p>)}</div></div>
  )}
  <div class="w">
    <div class={`art ${d.type === 'factcheck' ? 'fc' : ''} ${split ? 'ac-split' : ''} ac`}>
      <article data-pagefind-body>
        <PfMeta data={d} lang={lang} />
        {!split && <header class="ah">
          <FormatLabel data={d} />
          <h1>{d.title}</h1>
          <p class="stand">{d.standfirst}</p>
          <Byline lang={lang} published={d.published} updated={d.updated} title={d.title} path={route} kicker={k} location={d.type === 'news' ? d.location : null} />
        </header>}

        {!split && (d.type === 'news' || d.type === 'editorial') && (
          <figure class="hero">
            <div class="hero-ph">
              <Photo cover id={d.id} src={d.hero?.src} alt={hero.alt} size="lg" lang={lang} eager />
              {heroOv.value && !hasCover && <div class="hov" aria-hidden="true"><span class="ok">{heroOv.kicker}</span><span class="ov">{heroOv.value}</span></div>}
            </div>
            {hero.src && (hero.caption || hero.credit) && <figcaption><span>{hero.caption}</span>{hero.page ? <a class="pcred" href={`/photo-credits/#${hero.photoId}`}>{hero.short}</a> : <span class="pcred">{hero.credit}</span>}</figcaption>}
          </figure>
        )}

        {d.type === 'news' && d.keyPoints?.length > 0 && (
          <section class="kp ac-kp" aria-labelledby="kp-h"><h2 id="kp-h"><Icon name="list-bullets-duotone" class="ic" />{t.keyPoints}</h2><ul class={`n${Math.min(d.keyPoints.length, 4)}`}>{d.keyPoints.map((x: string) => <li><span set:html={emph(x)} /></li>)}</ul></section>
        )}

        {d.type === 'explainer' && d.shortAnswer && (
          <section class="short" aria-labelledby="sa-h"><h2 id="sa-h">{t.shortAnswer}</h2><p>{d.shortAnswer}</p></section>
        )}
        {toc.length > 1 && (
          <nav class="intoc" aria-labelledby="toc-h"><h2 id="toc-h">{t.inThisExplainer}</h2><ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol></nav>
        )}

        {d.type === 'factcheck' && (
          <section class="claim" aria-labelledby="claim-h">
            <div class="cl">
              <h2 class="lab" id="claim-h"><Icon name="quotes" />{t.theClaim}</h2>
              <blockquote>{d.factcheck.claim}</blockquote>
              <p class="seen">
                <b>{t.claimBy}:</b> {d.factcheck.claimant}
                {d.factcheck.seenOn && <><br /><b>{t.seenOn}:</b> {d.factcheck.seenOn}{firstSeen && <>, {t.firstSeen} {fmtD(firstSeen)}</>}</>}
              </p>
            </div>
            <div class="verdict">
              <p class={`vb v-${vkey}`}><span class="sr-only">{t.verdict}: </span><Icon name={vIcon} />{d.factcheck.verdict}</p>
              <ol class="scale4" aria-label={t.howWeRate}>
                {VERDICT_ORDER.map((v) => <li class={v === vkey ? 'on' : undefined} aria-current={v === vkey ? 'true' : undefined}><i></i>{t.verdicts[v]}</li>)}
              </ol>
            </div>
          </section>
        )}

        <div class={`body ${d.type === 'explainer' ? 'qa' : ''}`} set:html={html} />

        {tl.length > 0 && (
          <section class="ac-tl" aria-labelledby="tl-h"><h2 id="tl-h">{ig.headline ?? (lang === 'hi' ? 'घटनाक्रम' : 'Timeline')}</h2>
            <ol class={`n${tl.length}`}>{tl.map((x: any) => <li><b>{x.date}</b><span>{x.text}</span></li>)}</ol>
            {ig.source && <p class="ac-tls">{lang === 'hi' ? 'स्रोत' : 'Source'}: {ig.source}</p>}
          </section>
        )}

        {d.type === 'editorial' && <aside class="ednote"><Icon name="info" /><p>{t.editorialsNote} <a href={`${p}/standards/`}>{t.readStandards}</a></p></aside>}

        {d.updated && (
          <p class="upd"><Icon name="clock-counter-clockwise" /><span><b>{t.updated} {fmtDateTime(d.updated, lang)}:</b> {t.updateNote}</span></p>
        )}

        {(CORRECTIONS as any[]).filter((x) => x.article === d.id).sort((a, b) => String(a.date).localeCompare(String(b.date))).map((x) => (
          <aside class="corr" id={x.id}><b>{lang === 'hi' ? 'सुधार' : 'Correction'}, {fmtDate(new Date(`${x.date}T12:00:00+05:30`), lang)}:</b> {x.correction?.[lang] ?? x.correction?.en} <a href={`${p}/corrections/`}>{lang === 'hi' ? 'सुधारों का रिकॉर्ड' : 'Corrections log'}</a></aside>
        ))}

        <div data-pagefind-ignore><Sources lang={lang} sources={d.sources} />
        <Tags lang={lang} topics={d.topics} /></div>
      </article>

      <aside class="rail" aria-label={t.related}>
        {d.type === 'factcheck' && (
          <section class="box">
            <h2 class="rh" style="border:0;padding:0;margin-bottom:6px;font-size:14px">{t.howWeRate}</h2>
            <ul class="rate">{VERDICT_ORDER.map((v) => <li class={v === vkey ? 'cur' : undefined}><b>{t.verdicts[v]}</b>{t.rate[v]}</li>)}</ul>
            <a class="dl" href={`${p}/fact-check/methodology/`}>{t.ourMethod} <Icon name="caret-right" /></a>
          </section>
        )}
        {d.type === 'editorial' && (
          <section class="box"><h2 class="rh" style="border:0;padding:0;margin-bottom:6px;font-size:14px">{t.aboutEditorials}</h2><p>{t.aboutEditorialsText}</p><a class="dl" href={`${p}/standards/`}>{t.standards} <Icon name="caret-right" /></a></section>
        )}
        {where && (
          <section class="ac-where"><h2 class="rh">{lang === 'hi' ? 'कहाँ' : 'Where'}</h2>
            <div><svg class="ac-shp" viewBox={where.shape.vb} aria-hidden="true" style={`stroke-width:${where.shape.sw}`}><use href={`/maps/india.svg#${where.shape.id}`} /></svg><p><b>{where.place}</b></p></div>
          </section>
        )}
        {d.type !== 'editorial' && topicPages[0] && <FollowCard lang={lang} topic={topicPages[0]} />}
        <RailList title={t.related} items={related.slice(0, 5)} thumbs={d.type === 'news' ? 1 : 0} />
        <div class="stick">
          {d.type === 'news' && <RailList title={t.startHere} items={startHere} />}
          {d.type === 'explainer' && <RailList title={lang === 'hi' ? 'और समझिए' : 'More explainers'} items={(startHere.length ? startHere : sameType('explainer')).slice(0, 4)} />}
          {d.type === 'factcheck' && <RailList title={t.moreFactChecks} items={sameType('factcheck').slice(0, 4)} />}
          {d.type === 'editorial' && <RailList title={t.moreEditorials} items={sameType('editorial').slice(0, 5)} />}
        </div>
      </aside>
    </div>
  </div>
</Base>
