---
import MarketsBand from '../components/MarketsBand.astro';
// Homepage, English and Hindi. Which stories appear where is set in content/homepage.json;
// everything shown is read from the articles and the tracker data (see src/lib/home.ts).
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Seal from '../components/Seal.astro';
import Photo from '../components/Photo.astro';
import '../styles/home.css';
import '../styles/home-gn.css';
import { prefix, todayLine, emph } from '../lib/site';
import { UI, SECTION_NAMES, type Lang } from '../lib/i18n';
import { websiteLd } from '../lib/seo';
import { homeModel, H } from '../lib/home';
import CORRECTIONS from '../../content/corrections.json';

interface Props { lang: Lang; route: string }
const { lang, route } = Astro.props;
const t = UI[lang];
const h = H[lang];
const p = prefix(lang);
const S = SECTION_NAMES[lang];
const m = await homeModel(lang);
const L = m.lead;
const desc = lang === 'hi'
  ? 'गांधी न्यूज़: भारत और दुनिया की स्वतंत्र खबरें: राजनीति, अर्थव्यवस्था, विज्ञान-तकनीक और खेल, हिंदी और अंग्रेज़ी में।'
  : 'Gandhi News: independent news from India and the world: politics, economy, science and tech, and sports, in English and Hindi.';
const G = lang === 'hi' ? {
  headlines: 'सुर्खियां', liveX: 'लगातार कवरेज', readLead: 'पूरी खबर पढ़ें', india: 'भारत', markets: 'बाज़ार और आंकड़े',
  close: (d: string) => `${d} का बंद भाव`, ourView: 'हमारी राय', explainedX: 'खबरों के पीछे की बात', alt: 'In English', altX: 'हर खबर अंग्रेज़ी में भी',
} : {
  headlines: 'Headlines', liveX: 'Live coverage', readLead: 'Read the full story', india: 'India', markets: 'Markets and data',
  close: (d: string) => `Close, ${d}`, ourView: 'Our view', explainedX: 'The stories behind the news', alt: 'हिंदी में', altX: 'Every story, in Hindi too',
};
const latestCorrection: any = (CORRECTIONS as any[])[0];
---
<Base lang={lang} title={t.siteName} description={desc} path={route} active="home" jsonld={websiteLd(lang)}>
<div class="home gn">
  <!-- HEADLINES -->
  <section class="w g-ct" aria-labelledby="hl-h">
    <h2 id="hl-h">{G.headlines}</h2>
    <div class="g-g">
      <article class="g-c g-lead">
        <a href={L.href} class="g-im g-im-lead" tabindex="-1" aria-hidden="true"><Photo id={L.id} src={L.d.hero?.src} alt={L.d.hero?.alt} size="lg" lang={lang} eager /></a>
        <a href={L.href}><h1 id="lead-h"><span class="kk">{m.live.title}</span> {L.d.title}</h1></a>
        <p class="sf">{L.d.standfirst}</p>
        {m.live.points.length > 0 && <ul class="g-pts">{m.live.points.slice(0, 3).map((k: string) => <li>{k}</li>)}</ul>}
      </article>
      {m.headlines.slice(0, 2).map((x: any) => <article class="g-c"><a href={x.href} class="g-im" tabindex="-1" aria-hidden="true"><Photo id={x.id} src={x.d.hero?.src} lang={lang} /></a><a href={x.href}><h3><span class="kk">{x.kk}</span> {x.d.title}</h3></a></article>)}
      {m.headlines.slice(2, 4).map((x: any, i: number) => <article class="g-c g-tr"><a href={x.href}><h3><span class="kk">{x.kk}</span> {x.d.title}</h3></a>{i === 0 && <p class="sf">{x.d.standfirst}</p>}</article>)}
      {m.headlines.slice(4, 8).map((x: any) => <article class="g-c g-tr g-sm"><a href={x.href} class="g-im" tabindex="-1" aria-hidden="true"><Photo id={x.id} src={x.d.hero?.src} lang={lang} /></a><a href={x.href}><h3><span class="kk">{x.kk}</span> {x.d.title}</h3></a></article>)}
    </div>
  </section>

  <!-- LIVE BAND -->
  {m.live.feature && (
    <section class="g-band g-red" aria-labelledby="live-h">
      <div class="w g-live">
        <div class="g-bt"><h2 id="live-h">{m.live.title}</h2><span>{G.liveX}</span></div>
        <div class="g-lf">
          <a href={m.live.feature.href} class="g-im" tabindex="-1" aria-hidden="true"><Photo id={m.live.feature.id} src={m.live.feature.d.hero?.src} lang={lang} size="lg" /></a>
          <a href={m.live.feature.href}><h3>{m.live.feature.d.title}</h3></a>
          <div class="g-facts">{m.live.facts.map((x: any) => <div><Icon name={x.icon} /><span><b>{x.value}</b>{x.label}</span></div>)}</div>
        </div>
        <div class="g-ll">
          {m.live.list.map((x: any) => <a href={x.href}><h3>{x.d.title}</h3></a>)}
          {m.live.list.length < 2 && m.live.points.map((k: string) => <p>{k}</p>)}
          <a class="g-more" href={L.href}>{G.readLead} <Icon name="caret-right" /></a>
        </div>
      </div>
    </section>
  )}

  <!-- INDIA -->
  {m.india.length > 0 && (
    <section class="w g-ct" aria-labelledby="in-h">
      <h2 id="in-h"><a href={`${p}/states/`}>{G.india}</a></h2>
      <div class="g-g">
        {m.india.map((x: any, i: number) => <article class={i === 0 ? 'g-c g-s2' : 'g-c'}><a href={x.href} class={i === 0 ? 'g-im g-im-big' : 'g-im'} tabindex="-1" aria-hidden="true"><Photo id={x.id} src={x.d.hero?.src} lang={lang} size={i === 0 ? 'lg' : 'sm'} /></a><a href={x.href}><h3><span class="kk">{x.kk}</span> {x.d.title}</h3></a></article>)}
      </div>
    </section>
  )}

  <!-- MARKETS BAND -->
  <MarketsBand lang={lang} dashHref={m.dashHref} news={m.econ.map((x: any) => ({ href: x.href, title: x.d.title, kk: x.kk }))} />

  <!-- OPINION -->
  <section class="g-band g-tint" aria-labelledby="op-h">
    <div class="w g-split">
      <div class="g-bt"><h2 id="op-h"><a href={`${p}/opinion/`}>{h.opinion}</a></h2><span>{G.ourView}</span></div>
      <div class="g-g">
        {m.opinion.slice(0, 4).map((x: any) => <article class="g-c g-op"><Icon name="quotes" /><a href={x.href}><h3>{x.d.title}</h3></a></article>)}
      </div>
    </div>
  </section>

  <!-- WORLD, SCIENCE: desk containers -->
  {m.desks.filter((d: any) => d.key !== 'sports').map((dk: any) => (
    <section class="w g-ct" aria-label={S[dk.key]}>
      <h2><a href={`${p}/${dk.key}/`}>{S[dk.key]}</a></h2>
      <div class="g-g">
        {[dk.lead, ...dk.list].slice(0, 4).map((x0: any) => { const x = m.kk(x0); return <article class="g-c"><a href={x.href} class="g-im" tabindex="-1" aria-hidden="true"><Photo id={x.id} src={x.d.hero?.src} lang={lang} /></a><a href={x.href}><h3><span class="kk">{x.kk}</span> {x.d.title}</h3></a></article>; })}
      </div>
    </section>
  ))}

  <!-- EXPLAINED BAND -->
  <section class="g-band g-blk" aria-labelledby="ex-h">
    <div class="w g-split">
      <div class="g-bt"><h2 id="ex-h"><a href={`${p}/explained/`}>{h.explained}</a></h2><span>{G.explainedX}</span></div>
      <div class="g-g">
        {m.start.slice(0, 5).map((x: any, i: number) => (
          <article class={i === 0 ? 'g-c g-s2 g-r2' : i < 3 ? 'g-c' : 'g-c g-tr'}>
            {i < 3 && <a href={x.href} class={i === 0 ? 'g-im g-im-big' : 'g-im'} tabindex="-1" aria-hidden="true"><Photo id={x.id} src={x.d.hero?.src} lang={lang} size={i === 0 ? 'lg' : 'sm'} /></a>}
            <a href={x.href}><h3 class={i === 0 ? 'g-h28' : 'g-h17'}>{x.d.title}</h3></a>
            {i === 0 && <p class="sf">{x.d.standfirst}</p>}
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- SPORT -->
  {m.desks.filter((d: any) => d.key === 'sports').map((dk: any) => (
    <section class="w g-ct" aria-label={S.sports}>
      <h2><a href={`${p}/sports/`}>{S.sports}</a></h2>
      <div class="g-g">
        {[dk.lead, ...dk.list].slice(0, 3).map((x0: any, i: number) => { const x = m.kk(x0); return <article class={i === 0 ? 'g-c g-s2' : 'g-c'}><a href={x.href} class={i === 0 ? 'g-im g-im-big' : 'g-im'} tabindex="-1" aria-hidden="true"><Photo id={x.id} src={x.d.hero?.src} lang={lang} size={i === 0 ? 'lg' : 'sm'} /></a><a href={x.href}><h3 class={i === 0 ? 'g-h26' : undefined}><span class="kk">{x.kk}</span> {x.d.title}</h3></a></article>; })}
      </div>
    </section>
  ))}

  <!-- OTHER LANGUAGE + WEEK AHEAD -->
  <section class="g-band g-red" aria-labelledby="ol-h">
    <div class="w g-live">
      <div class="g-bt"><h2 id="ol-h" lang={lang === 'en' ? 'hi' : 'en'} class={lang === 'en' ? 'dv' : undefined}>{G.alt}</h2><span>{G.altX}</span></div>
      <div class="g-ll" lang={lang === 'en' ? 'hi' : 'en'}>
        {m.altLang.map((x: any) => <a href={x.href} class={lang === 'en' ? 'dv' : undefined}><h3>{x.title}</h3></a>)}
      </div>
      <div class="g-wk">
        <h3>{h.weekAhead}</h3>
        <dl>{m.week.map((x: any) => <><dt>{x.date}</dt><dd>{x.href ? <a href={x.href}>{x.text}</a> : x.text}</dd></>)}</dl>
      </div>
    </div>
  </section>

  <div class="g-rest">
  <!-- TRACKERS BAND -->
  <section class="band blk" aria-labelledby="trk-h">
    <div class="w">
      <div class="sh"><h2 id="trk-h">{h.trackers}</h2><span class="x">{h.trackersX}</span><a href={`${p}/trackers/`}>{h.allTrackers} <Icon name="caret-right" /></a></div>
      <div class="trk">
        {m.trackers.map((x: any) => (
          <a class="tc" href={x.href}>
            {x.id === 'bills-in-parliament-tracker' && <>
              <span class="ti"><Icon name="scroll" />{x.area}</span><h3>{x.short}</h3>
              <div class="bg"><b class="num">{m.billsCard.big}</b>{h.trk.billsBig}</div>
              <div class="tr">{m.billsCard.rows.map((r: any) => <div class="r"><span>{r.l}</span><span class="num">{r.n}</span><span class="b"><i class={r.rd ? 'rd' : undefined} style={`width:${r.w}`}></i></span></div>)}</div>
              {m.billsCard.winter.length > 0 && <div class="tl"><h4>{h.trk.winter}</h4>{m.billsCard.winter.map((w: string) => <div><span>{w}</span></div>)}</div>}
            </>}
            {x.id === 'economy-dashboard' && <>
              <span class="ti"><Icon name="chart-line" />{x.area}</span><h3>{x.short}</h3>
              <div class="bg"><b class="num">{m.econCard.big}</b>{m.econCard.bigLabel}</div>
              <div class="sp"><Fragment set:html={m.econCard.spark} /><div class="sx"><span>{m.econCard.x0}</span><span>{m.econCard.x1}</span></div></div>
              <div class="tl">{m.econCard.rows.map((r: any) => <div><span>{r.l}, {r.p}</span><b class="num">{r.v}</b></div>)}</div>
            </>}
            {x.id === 'election-calendar' && <>
              <span class="ti"><Icon name="calendar-blank" />{x.area}</span><h3>{x.short}</h3>
              <div class="bg"><b class="num">{m.elCard.big}</b>{h.trk.pollsBig}</div>
              <div class="tr">{m.elCard.rows.map((r: any) => <div class="r"><span>{r.l}</span><span class="num">{r.n}</span><span class="b"><i class={r.rd ? 'rd' : undefined} style={`width:${r.w}`}></i></span></div>)}</div>
              <div class="tl"><h4>{h.trk.next}</h4>{m.elCard.next.map((r: any) => <div><span>{r.l}</span><b>{r.v}</b></div>)}</div>
            </>}
            {x.id === 'budget-2026-27-promise-tracker' && <>
              <span class="ti"><Icon name="list-checks" />{x.area}</span><h3>{x.short}</h3>
              <div class="bg"><b class="num">{m.budgetCard.big}</b>{h.trk.promisesBig}</div>
              <div class="stk">{m.budgetCard.stat.map((s: any) => <i style={`flex:${s.n};background:${s.c}`}></i>)}</div>
              <div class="sk">{m.budgetCard.stat.map((s: any) => <span><i style={`background:${s.c}`}></i><b class="num">{s.n}</b>{s.l}</span>)}</div>
              <div class="tl"><h4>{h.trk.byArea}</h4>{m.budgetCard.areas.map((r: any) => <div><span>{r.l}</span><b class="num">{r.n}</b></div>)}</div>
            </>}
            {x.id === 'sc-cases-tracker' && <>
              <span class="ti"><Icon name="gavel" />{x.area}</span><h3>{x.short}</h3>
              <div class="bg"><b class="num">{m.scCard.big}</b>{h.trk.casesBig}</div>
              <div class="tr">{m.scCard.rows.map((r: any) => <div class="r"><span>{r.l}</span><span class="num">{r.n}</span><span class="b"><i class={r.rd ? 'rd' : r.gr ? 'gr' : undefined} style={`width:${r.w}`}></i></span></div>)}</div>
              {m.scCard.reserved.length > 0 && <div class="tl"><h4>{h.trk.reservedOn}</h4>{m.scCard.reserved.map((r: any) => <div><span>{r.l}</span><b>{r.v}</b></div>)}</div>}
            </>}
            <p class="l">{x.line}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <div class="w">
    <!-- DATA DESK + PARLIAMENT -->
    <section class="sec" aria-labelledby="dd-h">
      <div class="mapw">
        <div>
          <div class="sh"><h2 id="dd-h">{h.dataDesk}</h2><a href={m.mapModel.href}>{h.moreCharts} <Icon name="caret-right" /></a></div>
          <div class="mapc">
            <div>
              <svg class="map" viewBox="0 0 612 696" role="img" aria-labelledby="map-h">
                {m.mapModel.paths.map((x: any) => <use href={`/maps/india.svg#${x.id}`} fill={x.fill} stroke="#fff" stroke-width="0.8" />)}
              </svg>
              <p class="m">{h.mapSource(m.mapModel.asOf)}</p>
            </div>
            <div>
              <a class="k" href={m.mapModel.topicHref}>{m.mapModel.kicker}</a>
              <h3 id="map-h">{m.mapModel.title}</h3>
              <p class="d">{m.mapModel.text}</p>
              <div class="leg"><span><i style="background:#cc0000"></i>{h.early}</span><span><i style="background:#0d0d0d"></i>{h.late}</span><span><i style="background:#e2e2e2"></i>{h.others}</span></div>
              <div class="el"><h4><span>{h.state}</span><span>{h.termEnds}</span></h4>
                {m.mapModel.states.map((s: any) => <div class="r"><i style={`background:${s.early ? '#cc0000' : '#0d0d0d'}`}></i><span>{s.name}</span><span class="num">{s.when}</span></div>)}
              </div>
            </div>
          </div>
        </div>
        <div class="pt">
          <h3><a href={m.parl.href}>{h.parl}</a> <span>{m.parl.name}</span></h3>
          <div class="hsum"><div><b class="num">{m.parl.sittings}</b>{h.sittings}</div><div><b class="num">{m.parl.prod}</b>{h.lsProd}</div><div><b class="num">{m.parl.passed}</b>{h.billsPassed}</div></div>
          <table class="hpm">
            <thead><tr><th scope="col">{h.bill}</th>{h.cols.map((c: string) => <th scope="col">{c}</th>)}</tr></thead>
            <tbody>
              {m.parl.bills.map((b: any) => (
                <tr><td><a href={b.href}>{b.name}</a><span>{b.note}</span></td>{b.cells.map((cl: string, i: number) => <td data-l={h.cols[i]}><i class={cl} role="img" aria-label={cl === 'y' ? h.done : cl === 'c' ? h.cur : cl === 's' ? h.skip : h.not}></i></td>)}</tr>
              ))}
            </tbody>
          </table>
          <div class="hpk"><span><i class="y"></i>{h.done}</span><span><i class="c"></i>{h.cur}</span><span><i class="n"></i>{h.not}</span><span><i class="s"></i>{h.skip}</span><span class="srcr">{h.prs}</span></div>
        </div>
      </div>
    </section>
  </div>

  <!-- FACT CHECK BAND -->
  <section class="band red" aria-labelledby="fc-h">
    <div class="w">
      <div class="sh"><h2 id="fc-h">{h.fc}</h2><span class="x">{h.fcX}</span><a href={`${p}/fact-check/`}>{h.allFc} <Icon name="caret-right" /></a></div>
      <div class="fcg">
        {m.fcCards.map((x: any) => (
          <a class="fcc" href={x.href}>
            <span class={`vd v-${x.vk}`}>{x.verdict}</span>
            <h3>{x.claim}</h3>
            <p class="who">{x.who}</p>
            <p class="wf"><b>{h.whatWeFound}</b> {x.found}</p>
            <p class="src">{x.src}</p>
          </a>
        ))}
        <div class="ask">
          <h3>{h.ask}</h3>
          <ol class="hw">{h.steps.map((s: string) => <li>{s}</li>)}</ol>
          <div class="rsc"><h4>{h.howRate}</h4>
            {(['true', 'mostly', 'misleading', 'false'] as const).map((v) => <p><b>{t.verdicts[v]}</b>{t.rate[v]}</p>)}
            <a href={`${p}/fact-check/methodology/`}>{h.method}</a>
          </div>
          <!-- TODO(launch): point this at the WhatsApp tip line (wa.me/<number>) once the number exists. Until then it opens the contact page, which shows the placeholder. -->
          <a class="btn" href="https://wa.me/917760906195" rel="noopener" target="_blank"><Icon name="whatsapp-logo" />{h.wa}</a>
        </div>
      </div>
      <div class="fcstat"><span><b class="num">{m.fcStats.total}</b>{h.checked}</span>{m.fcStats.counts.map((c: any) => <span><b class="num">{c.n}</b>{lang === 'en' ? t.verdicts[c.v as 'true'].toLowerCase() : t.verdicts[c.v as 'true']}</span>)}</div>
    </div>
  </section>

  <div class="w">
    <!-- STANDARDS -->
    <section class="std2" aria-label={t.trust}>
      <div class="cor">
        <span class="k">{h.corrections}</span>
        {latestCorrection
          ? <p>{latestCorrection.summary?.[lang] ?? latestCorrection.summary}</p>
          : <p>{h.correctionsNone}</p>}
        <a href={`${p}/corrections/`}>{h.correctionsLog} <Icon name="caret-right" /></a>
      </div>
      <div class="prs">
        {h.pillars.map((x: any) => <a class="pr" href={`${p}${x.href}`}><Icon name={x.icon} /><span><b>{x.b}</b><p>{x.p}</p></span></a>)}
      </div>
    </section>
  </div>
  </div>
</div>
</Base>
