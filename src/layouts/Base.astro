---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import Seal from '../components/Seal.astro';
import Wordmark from '../components/Wordmark.astro';
import JsonLd from '../components/JsonLd.astro';
import { UI, SECTION_NAMES, type Lang } from '../lib/i18n';
import { SITE_LIVE, SITE_URL, abs, prefix, swapLangPath, todayLine, fmtShort, content, urlOf } from '../lib/site';
import HOME from '../../content/homepage.json';
import MARKETS from '../../content/data/markets.json';
import { indicator } from '../lib/data';
import { fmtNum } from '../lib/blocks.mjs';

export interface Crumb { name: string; href?: string }
interface Props {
  lang: Lang;
  title: string;
  description: string;
  path: string;
  /** Path of the same page in the other language; null when there is none. */
  altPath?: string | null;
  ogType?: 'website' | 'article';
  jsonld?: unknown[];
  crumbs?: Crumb[];
  active?: string;
  article?: { published?: Date; modified?: Date; section?: string; tags?: string[] };
  /** Share image for the page (a story's own photo); defaults to the site card. */
  image?: { url: string; width: number; height: number; alt: string } | null;
  /** Keep this page out of search engines even after launch (404). */
  noindex?: boolean;
}
const { lang, title, description, path, ogType = 'website', jsonld = [], crumbs = [], active = '', article, noindex = false, image = null } = Astro.props;
const altPath = Astro.props.altPath === undefined ? swapLangPath(path, lang === 'en' ? 'hi' : 'en') : Astro.props.altPath;
const t = UI[lang];
const p = prefix(lang);
const S = SECTION_NAMES[lang];
const enPath = lang === 'en' ? path : altPath;
const hiPath = lang === 'hi' ? path : altPath;
const fullTitle = path === `${p}/` ? (lang === 'hi' ? 'गांधी न्यूज़ (Gandhi News): भारत और दुनिया की ख़बरें, हिंदी और अंग्रेज़ी में' : 'Gandhi News: India and world news in English and Hindi') : `${title} | ${t.siteName}`;
const ogImage = image?.url ?? abs('/og-default.png');

const EN_TRY = ['CJP protest', 'Repo rate', 'SIR electoral rolls', 'GST Council', 'Labour codes'];
const HI_TRY = ['सीजेपी प्रदर्शन', 'रेपो रेट', 'एसआईआर', 'जीएसटी परिषद', 'श्रम संहिताएं'];
const nav = [
  ...['politics', 'world', 'economy', 'science', 'sports', 'states', 'policy', 'parliament'].map((k) => ({ key: k, label: S[k], href: `${p}/${k}/` })),
];
const more = [
  { key: 'elections', label: lang === 'hi' ? 'चुनाव 2027' : 'Elections 2027', href: `${p}/elections/` },
  { key: 'explained', label: t.explained, href: `${p}/explained/` },
  { key: 'opinion', label: t.opinion, href: `${p}/opinion/` },
  { key: 'fact-check', label: t.factCheck, href: `${p}/fact-check/` },
  { key: 'trackers', label: t.dataTrackers, href: `${p}/trackers/` },
  { key: 'topics', label: t.topics, href: `${p}/topics/` },
];
const moreActive = more.some((m) => m.key === active);
const trust = [
  { label: t.about, href: `${p}/about/` },
  { label: t.eic, href: `${p}/editor/` },
  { label: t.standards, href: `${p}/standards/` },
  { label: t.corrections, href: `${p}/corrections/` },
  { label: t.ownership, href: `${p}/ownership/` },
  { label: t.aiPolicy, href: `${p}/ai-policy/` },
  { label: t.grievance, href: `${p}/grievance/` },
  { label: t.contact, href: `${p}/contact/` },
];
// Mobile bottom tab bar
const tabs = [
  { icon: 'house', label: t.tabHome, href: `${p}/`, on: path === `${p}/` },
  { icon: 'clock', label: t.tabLatest, href: `${p}/latest/`, on: path === `${p}/latest/` },
  { icon: 'trophy', label: S.sports, href: `${p}/sports/`, on: path.startsWith(`${p}/sports/`) },
  { icon: 'bookmark-simple', label: t.tabSaved, href: `${p}/saved/`, on: path === `${p}/saved/` },
  { icon: 'magnifying-glass', label: t.tabSearch, href: `${p}/search/`, on: path === `${p}/search/` },
];

// Markets strip
// Live market numbers come from content/data/markets.json (refreshed every hour); the economy dashboard is the fallback.
const MKX: any = MARKETS;
const fromMk = (id: string, fallback: any) => {
  const x = [...(MKX.indices ?? []), ...(MKX.rates ?? [])].find((r: any) => r.id === id);
  if (!x || x.value == null || !MKX.session_date || String(MKX.session_date) < String(fallback?.release_date ?? '')) return fallback;
  return { latest_value: x.value, release_date: MKX.session_date, change_vs_previous: { change_pct: x.pct ?? 0 } };
};
const sensex = fromMk('sensex', indicator(lang, 'sensex'));
const nifty = fromMk('nifty-50', indicator(lang, 'nifty-50'));
const usd = fromMk('usd-inr', indicator(lang, 'usd-inr'));
const repo = indicator(lang, 'repo-rate');
const mkDate = fmtShort(sensex.release_date, lang, false);
const repoDate = fmtShort(repo.release_date, lang, false);
const pct = (v: number) => `${v > 0 ? '+' : v < 0 ? '−' : ''}${Math.abs(v).toFixed(2)}%`;

// Running stories strip: the labels of the homepage briefing items, each linking to its story.
const C = (await content())[lang];
const trending = (HOME.briefing?.items ?? []).map((b: any) => {
  const e: any = C.all.get(b.link);
  return e ? { label: String(b.lead[lang]).replace(/[:：]\s*$/, ''), href: urlOf(e.data) } : null;
}).filter(Boolean).slice(0, 7);

const breadcrumbLd = crumbs.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: abs(c.href ?? path) })),
    }
  : null;
const ld = [...jsonld, breadcrumbLd].filter(Boolean);
---
<!doctype html>
<html lang={lang === 'hi' ? 'hi' : 'en'} dir="ltr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={abs(path)} />
  {altPath && enPath && <link rel="alternate" hreflang="en-IN" href={abs(enPath)} />}
  {altPath && hiPath && <link rel="alternate" hreflang="hi-IN" href={abs(hiPath)} />}
  {altPath && enPath && <link rel="alternate" hreflang="x-default" href={abs(enPath)} />}
  {(!SITE_LIVE || noindex) && <meta name="robots" content="noindex,nofollow" />}
  {SITE_LIVE && !noindex && <meta name="robots" content="max-image-preview:large, max-snippet:-1, max-video-preview:-1" />}
  <meta name="theme-color" content="#0d0d0d" />
  <link rel="icon" href="/favicon.ico?v=gn2" sizes="48x48" />
  <link rel="icon" href="/favicon.svg?v=gn2" type="image/svg+xml" />
  <link rel="icon" href="/favicon.png?v=gn2" type="image/png" sizes="192x192" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=gn2" />
  <link rel="preload" href="/fonts/inter-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/google-sans-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin />
  {lang === 'hi' && <link rel="preload" href="/fonts/noto-sans-devanagari-devanagari-600-normal.woff2" as="font" type="font/woff2" crossorigin />}
  {lang === 'hi' && <link rel="preload" href="/fonts/noto-sans-devanagari-devanagari-500-normal.woff2" as="font" type="font/woff2" crossorigin />}
  <link rel="alternate" type="application/rss+xml" title={`${t.siteName} (${lang === 'hi' ? 'हिंदी' : 'English'})`} href={abs(`${p}/rss.xml`)} />
  <meta property="og:site_name" content="Gandhi News" />
  <meta property="og:type" content={ogType} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={abs(path)} />
  <meta property="og:locale" content={lang === 'hi' ? 'hi_IN' : 'en_IN'} />
  {altPath && <meta property="og:locale:alternate" content={lang === 'hi' ? 'en_IN' : 'hi_IN'} />}
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content={String(image?.width ?? 1200)} />
  <meta property="og:image:height" content={String(image?.height ?? 630)} />
  <meta property="og:image:alt" content={image?.alt || 'Gandhi News'} />
  {article?.published && <meta property="article:published_time" content={article.published.toISOString()} />}
  {article?.modified && <meta property="article:modified_time" content={article.modified.toISOString()} />}
  {article?.section && <meta property="article:section" content={article.section} />}
  {article?.tags?.map((tag) => <meta property="article:tag" content={tag} />)}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  {ld.map((d) => <JsonLd data={d} />)}
  <!-- Google Analytics 4: loads only on the live domain and only after the reader accepts cookies. -->
  <script is:inline>
    (function () {
      var live = location.hostname === 'gandhinews.com' || location.hostname === 'www.gandhinews.com';
      var choice = null; try { choice = localStorage.getItem('lv-cookies'); } catch (e) {}
      window.lvLoadGA = function () {
        if (!live || window.lvGA) return; window.lvGA = true;
        var s = document.createElement('script'); s.async = true; s.src = 'https://www.googletagmanager.com/gtag/js?id=G-RX4QDCN88Y'; document.head.appendChild(s);
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () { dataLayer.push(arguments); };
        gtag('js', new Date()); gtag('config', 'G-RX4QDCN88Y');
      };
      if (choice === 'yes') window.lvLoadGA();
    })();
  </script>
</head>
<body>
  <a class="skip" href="#main">{t.skip}</a>
  <header class="mh" id="nb">
    <div class="w mh-top">
      <span class="mh-date">{todayLine(lang)}</span>
      <div class="mh-act">
        <div class="mh-lang" role="group" aria-label={lang === 'hi' ? 'भाषा' : 'Language'}>
          {lang === 'en'
            ? <><span class="on" aria-current="true">English</span>{altPath ? <a class="hi" href={altPath} hreflang="hi" lang="hi" title={UI.en.switchLabel}>हिंदी</a> : <span class="hi off" lang="hi">हिंदी</span>}</>
            : <>{altPath ? <a href={altPath} hreflang="en" lang="en" title={UI.hi.switchLabel}>English</a> : <span class="off">English</span>}<span class="on hi" aria-current="true">हिंदी</span></>}
        </div>
        <a class="mh-ib" href={`${p}/search/`} title={t.search} data-so-open><Icon name="magnifying-glass" label={t.search} /></a>
        <a class="mh-sub" href={`${p}/subscribe/`}>{lang === 'hi' ? 'सुबह 7 बजे की ब्रीफिंग पाएं' : 'Get the 7 am briefing'}</a>
      </div>
    </div>
    <div class="w mh-brand">
      <a class="mh-wm" href={`${p}/`} aria-label={`${t.siteName}, ${t.home}`}><Wordmark /></a>
      <span class="mh-tag">{lang === 'hi' ? <>भारत और दुनिया,<br />हिंदी और अंग्रेज़ी में</> : <>India and the world,<br />in English and Hindi</>}</span>
    </div>
    <nav class="w mh-nav menu" aria-label={lang === 'hi' ? 'मुख्य' : 'Main'}>
      <a href={`${p}/`} class={active === 'home' ? 'on' : undefined} aria-current={active === 'home' ? 'page' : undefined}>{t.home}</a>
      {nav.map((n) => <a href={n.href} class={active === n.key ? 'on' : undefined} aria-current={active === n.key ? 'page' : undefined}>{n.label}</a>)}
      <details class={moreActive ? 'on' : undefined}>
        <summary>{t.more} <Icon name="caret-down" /></summary>
        <div class="dd">
          {more.map((m) => <a href={m.href} class={active === m.key ? 'on' : undefined}>{m.label}</a>)}
        </div>
      </details>
    </nav>
  </header>
  <nav class="mnav" aria-label={lang === 'hi' ? 'सेक्शन' : 'Sections'}>
    <ul class="w">
      {[...nav, ...more].map((n) => <li><a href={n.href} class={active === n.key ? 'on' : undefined}>{n.label}</a></li>)}
    </ul>
  </nav>
  <div class="tstrip">
    <div class="w">
      <div class="tt">
        {trending.map((x: any, i: number) => <a href={x.href} class={i === 0 ? 'hot' : undefined}>{x.label}</a>)}
      </div>
      <div class="tq">
        <span>{lang === 'hi' ? 'सेंसेक्स' : 'Sensex'} <b class="num">{fmtNum(sensex.latest_value, 2)}</b> <span class={`num ${sensex.change_vs_previous.change_pct >= 0 ? 'up' : 'dn'}`}>{pct(sensex.change_vs_previous.change_pct)}</span></span>
        <span>{lang === 'hi' ? 'निफ्टी 50' : 'Nifty 50'} <b class="num">{fmtNum(nifty.latest_value, 2)}</b> <span class={`num ${nifty.change_vs_previous.change_pct >= 0 ? 'up' : 'dn'}`}>{pct(nifty.change_vs_previous.change_pct)}</span></span>
        <span>₹ / $ <b class="num">{fmtNum(usd.latest_value, 2)}</b></span>
      </div>
    </div>
  </div>
  {crumbs.length > 0 && (
    <nav class="crumb" aria-label={lang === 'hi' ? 'आप यहां हैं' : 'Breadcrumb'}>
      <ol class="w">
        {crumbs.map((c, i) =>
          i < crumbs.length - 1
            ? <li><a href={c.href}>{c.name}</a><Icon name="caret-right" /></li>
            : <li><span aria-current="page">{c.name}</span></li>)}
      </ol>
    </nav>
  )}
  <main id="main" tabindex="-1">
    <slot />
  </main>
  <footer>
    <div class="w">
      <div class="nlr" id="newsletter">
        <div><h2>{t.newsletterTitle}</h2><p>{t.newsletterText}</p></div>
        <form action="/api/subscribe" method="post" data-newsletter>
          <label class="sr-only" for="nl-email">{t.email}</label>
          <input id="nl-email" name="email" type="email" autocomplete="email" required placeholder={t.email} />
          <input type="hidden" name="lang" value={lang} />
          <input type="hidden" name="source" value="footer" />
          <input class="hp" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <button type="submit">{t.signUp}</button>
        </form>
      </div>
      <div class="g">
        <div><a class="fwm" href={`${p}/`} aria-label={t.siteName}><Wordmark /></a><p class="named">{t.named}</p></div>
        <div><h2 class="fh">{t.sections}</h2><ul>{['politics', 'world', 'economy', 'science', 'sports', 'states', 'policy', 'parliament'].map((k) => <li><a href={`${p}/${k}/`}>{S[k]}</a></li>)}</ul></div>
        <div><h2 class="fh">{t.features}</h2><ul>{more.map((m) => <li><a href={m.href}>{m.label}</a></li>)}</ul></div>
        <div><h2 class="fh">{t.trust}</h2><ul>{trust.map((x) => <li><a href={x.href}>{x.label}</a></li>)}</ul></div>
        <!-- TODO(launch): link YouTube once the channel exists. -->
        <div><h2 class="fh">{t.follow}</h2><ul><li><a href={`${p}/rss.xml`}>RSS</a></li><li><a href="https://wa.me/917760906195" rel="noopener" target="_blank">WhatsApp</a></li><li><a href="https://www.instagram.com/lokvoxcom" rel="me noopener" target="_blank">Instagram</a></li><li><a href="https://x.com/lokvoxcom" rel="me noopener" target="_blank">X</a></li></ul></div>
      </div>
      <div class="b"><span>{t.rights}</span><span class="legal"><a href={`${p}/privacy/`}>{t.privacy}</a> · <a href={`${p}/terms/`}>{t.terms}</a> · <a href={`${p}/privacy/#cookies`} data-cookie-settings>{t.cookies}</a> · <a href="/photo-credits/">{lang === 'hi' ? 'फोटो क्रेडिट' : 'Photo credits'}</a></span></div>
    </div>
  </footer>
  <nav class="tab" aria-label={lang === 'hi' ? 'त्वरित नेविगेशन' : 'Quick navigation'}>
    {tabs.map((x) => <a href={x.href} class={x.on ? 'on' : undefined} aria-current={x.on ? 'page' : undefined} data-so-open={x.icon === 'magnifying-glass' ? '' : undefined}><Icon name={x.icon} />{x.label}</a>)}
  </nav>
  <div class="toast" role="status" aria-live="polite" id="toast"></div>
  <script>
    const nb = document.getElementById('nb');
    let compact = false;
    const onScroll = () => {
      const c = window.scrollY > 120;
      if (c !== compact) { compact = c; nb?.classList.toggle('cp', c); }
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
    // Close the "More" menu on outside click / Escape.
    const dd = document.querySelector<HTMLDetailsElement>('.menu details');
    document.addEventListener('click', (e) => { if (dd?.open && !dd.contains(e.target as Node)) dd.open = false; });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && dd?.open) { dd.open = false; dd.querySelector('summary')?.focus(); } });
    // Morning Brief signup: post to our own API and show the result in place.
    // Replace the form with a confirmation panel right where the reader signed up.
    const done = (f: HTMLFormElement, email: string, hi: boolean) => {
      const page = f.closest('.subc');
      const box = document.createElement('div');
      box.className = page ? 'subok' : 'subok sm';
      box.setAttribute('role', 'status');
      const esc = (x: string) => x.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' } as any)[c]);
      box.innerHTML = `<span class="env" aria-hidden="true"><svg viewBox="0 0 256 256"><path fill="currentColor" d="M224,48H32a8,8,0,0,0-8,8V192a16,16,0,0,0,16,16H216a16,16,0,0,0,16-16V56A8,8,0,0,0,224,48Zm-96,85.15L52.57,64H203.43ZM98.71,128,40,181.81V74.19Zm11.84,10.85,12,11.05a8,8,0,0,0,10.82,0l12-11.05,58,53.15H52.57ZM157.29,128,216,74.18V181.82Z"/></svg><i></i></span>
        <div><b>${hi ? 'अपना इनबॉक्स देखें' : 'Check your inbox'}</b>
        <p>${hi ? `हमने <strong>${esc(email)}</strong> पर पुष्टि का लिंक भेजा है। उस पर क्लिक करते ही आप सब्सक्राइब हो जाएंगे।` : `We have sent a confirmation link to <strong>${esc(email)}</strong>. Click it and you are in.`}</p>
        <p class="sm2">${hi ? 'ईमेल न दिखे तो स्पैम या प्रमोशन फोल्डर देखें और उसे "स्पैम नहीं" बताएं।' : 'Not there? Look in Spam or Promotions and mark it "Not spam".'}</p>
        <button type="button" class="again">${hi ? 'दूसरा ईमेल इस्तेमाल करें' : 'Use a different email'}</button></div>`;
      const target: HTMLElement = page ? (page.querySelector('.subwrap') as HTMLElement) || f : f;
      target.hidden = true;
      target.after(box);
      box.querySelector('.again')?.addEventListener('click', () => { box.remove(); target.hidden = false; f.reset(); (f.querySelector('input[type=email]') as HTMLInputElement)?.focus(); });
      if (page) page.scrollIntoView({ behavior: 'smooth', block: 'start' });
    };
    document.querySelectorAll<HTMLFormElement>('form[data-newsletter]').forEach((f) => {
      f.addEventListener('submit', async (e) => {
        e.preventDefault();
        const hi = document.documentElement.lang === 'hi';
        const toast = document.getElementById('toast');
        const say = (m: string) => { if (toast) { toast.textContent = m; toast.classList.add('show'); setTimeout(() => toast.classList.remove('show'), 4200); } };
        const btn = f.querySelector('button'); if (btn) btn.disabled = true;
        try {
          const r = await fetch(f.action, { method: 'POST', body: new FormData(f), headers: { accept: 'application/json' } });
          const j = await r.json().catch(() => ({}));
          if (j.status === 'invalid') say(hi ? 'कृपया सही ईमेल पता डालें।' : 'Please enter a valid email address.');
          else if (j.status === 'confirmed') say(hi ? 'आप पहले से सब्सक्राइब हैं।' : 'You are already subscribed.');
          else if (r.ok) { done(f, String(new FormData(f).get('email') || ''), hi); }
          else say(hi ? 'अभी सब्सक्राइब नहीं हो सका। थोड़ी देर बाद कोशिश करें।' : 'Could not subscribe right now. Please try again later.');
        } catch { say(hi ? 'अभी सब्सक्राइब नहीं हो सका। थोड़ी देर बाद कोशिश करें।' : 'Could not subscribe right now. Please try again later.'); }
        if (btn) btn.disabled = false;
      });
    });
  </script>
  <div class="so" id="so" hidden role="dialog" aria-modal="true" aria-label={t.search} data-search-url={`${p}/search/`}
    data-l-none={lang === 'hi' ? 'कोई नतीजा नहीं मिला। दूसरे शब्द आज़माएं।' : 'Nothing found. Try other words.'}
    data-l-all={lang === 'hi' ? 'सभी नतीजे देखें' : 'See all results'} data-l-off={lang === 'hi' ? 'खोज अभी उपलब्ध नहीं है।' : 'Search is not available right now.'}>
    <div class="so-bg" data-so-close></div>
    <div class="so-p">
      <form class="so-f" role="search" action={`${p}/search/`} method="get">
        <span class="so-seal"><Seal /></span>
        <input name="q" type="search" autocomplete="off" spellcheck="false" placeholder={lang === 'hi' ? 'खबरें, विषय, ट्रैकर खोजें' : 'Search stories, topics, trackers'} aria-label={t.search} data-so-q />
        <button type="button" class="so-x" data-so-close aria-label={lang === 'hi' ? 'बंद करें' : 'Close'}><Icon name="x" /></button>
      </form>
      <div class="so-b">
        <div class="so-e" data-so-empty>
          <p class="so-h">{lang === 'hi' ? 'लोग खोज रहे हैं' : 'Trending'}</p>
          <div class="so-c">{(lang === 'hi' ? HI_TRY : EN_TRY).map((x) => <button type="button" data-so-try={x}>{x}</button>)}</div>
        </div>
        <ol class="so-r" data-so-res></ol>
        <p class="so-m" data-so-msg hidden></p>
      </div>
    </div>
  </div>
  <script is:inline>
  (function () {
    var so = document.getElementById('so'); if (!so) return;
    var q = so.querySelector('[data-so-q]'), res = so.querySelector('[data-so-res]'), msg = so.querySelector('[data-so-msg]'), empty = so.querySelector('[data-so-empty]');
    var D = so.dataset, pf = null, loading = null, timer, sel = -1, last = null;
    function load() {
      if (pf || loading) return loading;
      var u = '/pagefind/pagefind.js';
      loading = import(u).then(function (m) { pf = m; return pf.options({ excerptLength: 18 }).then(function () { return pf.init(); }); }).catch(function () { msg.textContent = D.lOff; msg.hidden = false; });
      return loading;
    }
    function open(e) { if (e) e.preventDefault(); last = document.activeElement; so.hidden = false; document.documentElement.classList.add('so-on'); load(); setTimeout(function () { q.focus(); q.select(); }, 10); }
    function close() { so.hidden = true; document.documentElement.classList.remove('so-on'); if (last && last.focus) last.focus(); }
    function mark(i) { var items = res.querySelectorAll('a'); items.forEach(function (a, j) { a.classList.toggle('on', j === i); }); sel = i; if (items[i]) items[i].scrollIntoView({ block: 'nearest' }); }
    async function run() {
      var term = q.value.trim();
      if (!term) { res.replaceChildren(); msg.hidden = true; empty.hidden = false; return; }
      empty.hidden = true; await load(); if (!pf) return;
      var r = await pf.search(term); if (!r || q.value.trim() !== term) return;
      var data = await Promise.all(r.results.slice(0, 12).map(function (x) { return x.data(); }));
      if (q.value.trim() !== term) return;
      res.replaceChildren(); sel = -1;
      data.forEach(function (d) {
        var li = document.createElement('li'), a = document.createElement('a'); a.href = d.url;
        var k = document.createElement('span'); k.className = 'k'; k.textContent = (d.meta && d.meta.format) || '';
        var h = document.createElement('b'); h.textContent = (d.meta && d.meta.title) || d.url;
        var x = document.createElement('span'); x.className = 'x'; x.innerHTML = d.excerpt;
        a.append(k, h, x); li.append(a); res.append(li);
      });
      msg.textContent = D.lNone; msg.hidden = data.length > 0;
    }
    document.querySelectorAll('[data-so-open]').forEach(function (b) { b.addEventListener('click', open); });
    so.querySelectorAll('[data-so-close]').forEach(function (b) { b.addEventListener('click', close); });
    so.querySelectorAll('[data-so-try]').forEach(function (b) { b.addEventListener('click', function () { q.value = b.getAttribute('data-so-try'); run(); q.focus(); }); });
    q.addEventListener('input', function () { clearTimeout(timer); timer = setTimeout(run, 160); });
    so.querySelector('form').addEventListener('submit', function (e) { e.preventDefault(); var a = res.querySelectorAll('a')[sel < 0 ? 0 : sel]; if (a) location.href = a.href; });
    document.addEventListener('keydown', function (e) {
      var typing = /^(INPUT|TEXTAREA|SELECT)$/.test((e.target && e.target.tagName) || '') || (e.target && e.target.isContentEditable);
      if (so.hidden) {
        if ((e.key === 'k' && (e.metaKey || e.ctrlKey)) || (e.key === '/' && !typing)) open(e);
        return;
      }
      var n = res.querySelectorAll('a').length;
      if (e.key === 'Escape') { e.preventDefault(); close(); }
      else if (e.key === 'ArrowDown' && n) { e.preventDefault(); mark(Math.min(n - 1, sel + 1)); }
      else if (e.key === 'ArrowUp' && n) { e.preventDefault(); mark(Math.max(0, sel - 1)); }
    });
  })();
  </script>
  <div class="ck" id="ck" role="region" aria-label={lang === 'hi' ? 'कुकीज़' : 'Cookies'} hidden>
    <p>{lang === 'hi'
      ? <>हम यह समझने के लिए कुकीज़ इस्तेमाल करते हैं कि कौन-सी खबरें पढ़ी जाती हैं। विज्ञापन वाली कुकीज़ नहीं। <a href={`${p}/privacy/#cookies`}>और जानें</a></>
      : <>We use cookies to understand which stories are read. No advertising cookies. <a href={`${p}/privacy/#cookies`}>Learn more</a></>}</p>
    <div class="ckb"><button type="button" data-ck="no">{lang === 'hi' ? 'मना करें' : 'Decline'}</button><button type="button" class="ok" data-ck="yes">{lang === 'hi' ? 'स्वीकार करें' : 'Accept'}</button></div>
  </div>
  <script is:inline>
    (function () {
      var box = document.getElementById('ck'); if (!box) return;
      var get = function () { try { return localStorage.getItem('lv-cookies'); } catch (e) { return null; } };
      var set = function (v) { try { localStorage.setItem('lv-cookies', v); } catch (e) {} };
      if (!get()) box.hidden = false;
      box.addEventListener('click', function (e) {
        var b = e.target.closest('[data-ck]'); if (!b) return;
        set(b.getAttribute('data-ck')); box.hidden = true;
        if (b.getAttribute('data-ck') === 'yes' && window.lvLoadGA) window.lvLoadGA();
      });
      document.querySelectorAll('[data-cookie-settings]').forEach(function (a) {
        a.addEventListener('click', function (e) { e.preventDefault(); box.hidden = false; });
      });
    })();
  </script>
</body>
</html>
