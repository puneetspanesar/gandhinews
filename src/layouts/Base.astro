---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import Seal from '../components/Seal.astro';
import JsonLd from '../components/JsonLd.astro';
import { UI, SECTION_NAMES, type Lang } from '../lib/i18n';
import { SITE_LIVE, SITE_URL, abs, prefix, swapLangPath, todayLine, fmtShort } from '../lib/site';
import { indicator } from '../lib/data';
import { fmtNum } from '../lib/blocks.mjs';

export interface Crumb { name: string; href?: string }
interface Props {
  lang: Lang;
  title: string;
  description: string;
  path: string;
  /** Path of the same page in the other language; null when there is none. */
  altPath?: string | null;
  ogType?: 'website' | 'article';
  jsonld?: unknown[];
  crumbs?: Crumb[];
  active?: string;
  article?: { published?: Date; modified?: Date; section?: string; tags?: string[] };
  /** Keep this page out of search engines even after launch (404). */
  noindex?: boolean;
}
const { lang, title, description, path, ogType = 'website', jsonld = [], crumbs = [], active = '', article, noindex = false } = Astro.props;
const altPath = Astro.props.altPath === undefined ? swapLangPath(path, lang === 'en' ? 'hi' : 'en') : Astro.props.altPath;
const t = UI[lang];
const p = prefix(lang);
const S = SECTION_NAMES[lang];
const enPath = lang === 'en' ? path : altPath;
const hiPath = lang === 'hi' ? path : altPath;
const fullTitle = path === `${p}/` ? `${t.siteName}: ${t.motto}` : `${title} | ${t.siteName}`;
const ogImage = abs('/og-default.png');

const nav = [
  ...['politics', 'policy', 'economy', 'parliament', 'states', 'world'].map((k) => ({ key: k, label: S[k], href: `${p}/${k}/` })),
  { key: 'fact-check', label: t.factCheck, href: `${p}/fact-check/` },
];
const more = [
  { key: 'explained', label: t.explained, href: `${p}/explained/` },
  { key: 'opinion', label: t.opinion, href: `${p}/opinion/` },
  { key: 'trackers', label: t.dataTrackers, href: `${p}/trackers/` },
  { key: 'topics', label: t.topics, href: `${p}/topics/` },
];
const moreActive = more.some((m) => m.key === active);
const trust = [
  { label: t.about, href: `${p}/about/` },
  { label: t.standards, href: `${p}/standards/` },
  { label: t.corrections, href: `${p}/corrections/` },
  { label: t.ownership, href: `${p}/ownership/` },
  { label: t.aiPolicy, href: `${p}/ai-policy/` },
  { label: t.grievance, href: `${p}/grievance/` },
  { label: t.contact, href: `${p}/contact/` },
];
// Mobile bottom tab bar
const tabs = [
  { icon: 'house', label: t.tabHome, href: `${p}/`, on: path === `${p}/` },
  { icon: 'clock', label: t.tabLatest, href: `${p}/latest/`, on: path === `${p}/latest/` },
  { icon: 'list-checks', label: t.tabTrackers, href: `${p}/trackers/`, on: path.startsWith(`${p}/trackers/`) },
  { icon: 'bookmark-simple', label: t.tabSaved, href: `${p}/saved/`, on: path === `${p}/saved/` },
  { icon: 'magnifying-glass', label: t.tabSearch, href: `${p}/search/`, on: path === `${p}/search/` },
];

// Markets strip
const sensex = indicator(lang, 'sensex');
const nifty = indicator(lang, 'nifty-50');
const usd = indicator(lang, 'usd-inr');
const repo = indicator(lang, 'repo-rate');
const mkDate = fmtShort(sensex.release_date, lang, false);
const repoDate = fmtShort(repo.release_date, lang, false);
const pct = (v: number) => `${v > 0 ? '+' : v < 0 ? '−' : ''}${Math.abs(v).toFixed(2)}%`;

const breadcrumbLd = crumbs.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: abs(c.href ?? path) })),
    }
  : null;
const ld = [...jsonld, breadcrumbLd].filter(Boolean);
---
<!doctype html>
<html lang={lang === 'hi' ? 'hi' : 'en'} dir="ltr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={abs(path)} />
  {altPath && enPath && <link rel="alternate" hreflang="en-IN" href={abs(enPath)} />}
  {altPath && hiPath && <link rel="alternate" hreflang="hi-IN" href={abs(hiPath)} />}
  {altPath && enPath && <link rel="alternate" hreflang="x-default" href={abs(enPath)} />}
  {(!SITE_LIVE || noindex) && <meta name="robots" content="noindex,nofollow" />}
  {SITE_LIVE && !noindex && <meta name="robots" content="max-image-preview:large, max-snippet:-1, max-video-preview:-1" />}
  <meta name="theme-color" content="#0d0d0d" />
  <link rel="icon" href="/favicon.ico?v=lv2" sizes="48x48" />
  <link rel="icon" href="/favicon.svg?v=lv2" type="image/svg+xml" />
  <link rel="icon" href="/favicon.png?v=lv2" type="image/png" sizes="192x192" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=lv2" />
  <link rel="preload" href="/fonts/inter-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/google-sans-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/noto-sans-devanagari-devanagari-600-normal.woff2" as="font" type="font/woff2" crossorigin />
  {lang === 'hi' && <link rel="preload" href="/fonts/noto-sans-devanagari-devanagari-500-normal.woff2" as="font" type="font/woff2" crossorigin />}
  <link rel="alternate" type="application/rss+xml" title={`${t.siteName} (${lang === 'hi' ? 'हिंदी' : 'English'})`} href={abs(`${p}/rss.xml`)} />
  <meta property="og:site_name" content="LokVox" />
  <meta property="og:type" content={ogType} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={abs(path)} />
  <meta property="og:locale" content={lang === 'hi' ? 'hi_IN' : 'en_IN'} />
  {altPath && <meta property="og:locale:alternate" content={lang === 'hi' ? 'en_IN' : 'hi_IN'} />}
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="LokVox" />
  {article?.published && <meta property="article:published_time" content={article.published.toISOString()} />}
  {article?.modified && <meta property="article:modified_time" content={article.modified.toISOString()} />}
  {article?.section && <meta property="article:section" content={article.section} />}
  {article?.tags?.map((tag) => <meta property="article:tag" content={tag} />)}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  {ld.map((d) => <JsonLd data={d} />)}
  <!-- Google Analytics 4: loads only on the live domain and only after the reader accepts cookies. -->
  <script is:inline>
    (function () {
      var live = location.hostname === 'lokvox.com' || location.hostname === 'www.lokvox.com';
      var choice = null; try { choice = localStorage.getItem('lv-cookies'); } catch (e) {}
      window.lvLoadGA = function () {
        if (!live || window.lvGA) return; window.lvGA = true;
        var s = document.createElement('script'); s.async = true; s.src = 'https://www.googletagmanager.com/gtag/js?id=G-RX4QDCN88Y'; document.head.appendChild(s);
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () { dataLayer.push(arguments); };
        gtag('js', new Date()); gtag('config', 'G-RX4QDCN88Y');
      };
      if (choice === 'yes') window.lvLoadGA();
    })();
  </script>
</head>
<body>
  <a class="skip" href="#main">{t.skip}</a>
  <header class="nb" id="nb">
    <div class="w">
      <a class="brand" href={`${p}/`} aria-label={`${t.siteName}, ${t.home}`}><Seal /><span class="wm">LokVox</span></a>
      <nav class="menu" aria-label={lang === 'hi' ? 'मुख्य' : 'Main'}>
        {nav.map((n) => <a href={n.href} class={active === n.key ? 'on' : undefined} aria-current={active === n.key ? 'page' : undefined}>{n.label}</a>)}
        <details class={moreActive ? 'on' : undefined}>
          <summary>{t.more} <Icon name="caret-down" /></summary>
          <div class="dd">
            {more.map((m) => <a href={m.href} class={active === m.key ? 'on' : undefined}>{m.label}</a>)}
          </div>
        </details>
      </nav>
      <div class="act">
        <a class="ib" href={`${p}/search/`} title={t.search}><Icon name="magnifying-glass" label={t.search} /></a>
        <div class="lang" role="group" aria-label={lang === 'hi' ? 'भाषा' : 'Language'}>
          {lang === 'en'
            ? <><span class="on" aria-current="true">EN</span>{altPath ? <a class="hi" href={altPath} hreflang="hi" lang="hi" title={UI.en.switchLabel}>हिंदी</a> : <span class="hi" lang="hi">हिंदी</span>}</>
            : <>{altPath ? <a href={altPath} hreflang="en" lang="en" title={UI.hi.switchLabel}>EN</a> : <span>EN</span>}<span class="on hi" aria-current="true">हिंदी</span></>}
        </div>
        <span class="sep" aria-hidden="true"></span>
        <a class="sub" href={`${p}/subscribe/`}>{t.subscribe}</a>
      </div>
    </div>
  </header>
  <nav class="mnav" aria-label={lang === 'hi' ? 'सेक्शन' : 'Sections'}>
    <ul class="w">
      {[...nav, ...more].map((n) => <li><a href={n.href} class={active === n.key ? 'on' : undefined}>{n.label}</a></li>)}
    </ul>
  </nav>
  <div class="subnav">
    <div class="w">
      <div class="date">{todayLine(lang)}</div>
      <div class="q"><span class="l">{lang === 'hi' ? 'सेंसेक्स' : 'Sensex'}</span><b class="num">{fmtNum(sensex.latest_value, 2)}</b><span class={`num ${sensex.change_vs_previous.change_pct >= 0 ? 'up' : 'dn'}`}>{pct(sensex.change_vs_previous.change_pct)}</span></div>
      <div class="q"><span class="l">{lang === 'hi' ? 'निफ्टी 50' : 'Nifty 50'}</span><b class="num">{fmtNum(nifty.latest_value, 2)}</b><span class={`num ${nifty.change_vs_previous.change_pct >= 0 ? 'up' : 'dn'}`}>{pct(nifty.change_vs_previous.change_pct)}</span></div>
      <div class="q"><span class="l">₹ / $</span><b class="num">{fmtNum(usd.latest_value, 2)}</b><span class="l num">{fmtNum(usd.change_vs_previous.change, 2, true)}</span></div>
      <div class="q"><span class="l">{t.repo}</span><b class="num">{fmtNum(repo.latest_value, 2)}%</b><span class="l num">{lang === 'hi' ? `${repoDate} को +${repo.change_vs_previous.change.toFixed(2)}` : `+${repo.change_vs_previous.change.toFixed(2)} on ${repoDate}`}</span></div>
      <div class="q mk">{lang === 'hi' ? `${t.markets}: ${mkDate} का ${t.close}` : `${t.markets}: ${mkDate} ${t.close}`}</div>
      <div class="motto">{t.motto}</div>
    </div>
  </div>
  {crumbs.length > 0 && (
    <nav class="crumb" aria-label={lang === 'hi' ? 'आप यहां हैं' : 'Breadcrumb'}>
      <ol class="w">
        {crumbs.map((c, i) =>
          i < crumbs.length - 1
            ? <li><a href={c.href}>{c.name}</a><Icon name="caret-right" /></li>
            : <li><span aria-current="page">{c.name}</span></li>)}
      </ol>
    </nav>
  )}
  <main id="main" tabindex="-1">
    <slot />
  </main>
  <footer>
    <div class="w">
      <div class="nlr" id="newsletter">
        <div><h2>{t.newsletterTitle}</h2><p>{t.newsletterText}</p></div>
        <form action="/api/subscribe" method="post" data-newsletter>
          <label class="sr-only" for="nl-email">{t.email}</label>
          <input id="nl-email" name="email" type="email" autocomplete="email" required placeholder={t.email} />
          <input type="hidden" name="lang" value={lang} />
          <input type="hidden" name="source" value="footer" />
          <input class="hp" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <button type="submit">{t.signUp}</button>
        </form>
      </div>
      <div class="g">
        <div><a class="brand" href={`${p}/`}><Seal /><span class="wm" style="color:#fff">LokVox</span></a><p class="named">{t.named}</p></div>
        <div><h2 class="fh">{t.sections}</h2><ul>{['politics', 'policy', 'economy', 'parliament', 'states', 'world'].map((k) => <li><a href={`${p}/${k}/`}>{S[k]}</a></li>)}</ul></div>
        <div><h2 class="fh">{t.features}</h2><ul>{[...more, { key: 'fact-check', label: t.factCheck, href: `${p}/fact-check/` }].map((m) => <li><a href={m.href}>{m.label}</a></li>)}</ul></div>
        <div><h2 class="fh">{t.trust}</h2><ul>{trust.map((x) => <li><a href={x.href}>{x.label}</a></li>)}</ul></div>
        <!-- TODO(launch): link WhatsApp, Instagram, YouTube and X once the accounts exist. WhatsApp points at the contact page placeholder for now. -->
        <div><h2 class="fh">{t.follow}</h2><ul><li><a href={`${p}/rss.xml`}>RSS</a></li><li><a href="https://wa.me/917760906195" rel="noopener" target="_blank">WhatsApp</a></li><li>Instagram</li><li>YouTube</li><li>X</li></ul></div>
      </div>
      <div class="b"><span>{t.rights}</span><span class="legal"><a href={`${p}/privacy/`}>{t.privacy}</a> · <a href={`${p}/terms/`}>{t.terms}</a> · <a href={`${p}/privacy/#cookies`} data-cookie-settings>{t.cookies}</a> · <a href="/photo-credits/">{lang === 'hi' ? 'फोटो क्रेडिट' : 'Photo credits'}</a></span></div>
    </div>
  </footer>
  <nav class="tab" aria-label={lang === 'hi' ? 'त्वरित नेविगेशन' : 'Quick navigation'}>
    {tabs.map((x) => <a href={x.href} class={x.on ? 'on' : undefined} aria-current={x.on ? 'page' : undefined}><Icon name={x.icon} />{x.label}</a>)}
  </nav>
  <div class="toast" role="status" aria-live="polite" id="toast"></div>
  <script>
    const nb = document.getElementById('nb');
    let compact = false;
    const onScroll = () => {
      const c = window.scrollY > 120;
      if (c !== compact) { compact = c; nb?.classList.toggle('cp', c); }
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
    // Close the "More" menu on outside click / Escape.
    const dd = document.querySelector<HTMLDetailsElement>('.menu details');
    document.addEventListener('click', (e) => { if (dd?.open && !dd.contains(e.target as Node)) dd.open = false; });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && dd?.open) { dd.open = false; dd.querySelector('summary')?.focus(); } });
    // Morning Brief signup: post to our own API and show the result in place.
    document.querySelectorAll<HTMLFormElement>('form[data-newsletter]').forEach((f) => {
      f.addEventListener('submit', async (e) => {
        e.preventDefault();
        const hi = document.documentElement.lang === 'hi';
        const toast = document.getElementById('toast');
        const say = (m: string) => { if (toast) { toast.textContent = m; toast.classList.add('show'); setTimeout(() => toast.classList.remove('show'), 4200); } };
        const btn = f.querySelector('button'); if (btn) btn.disabled = true;
        try {
          const r = await fetch(f.action, { method: 'POST', body: new FormData(f), headers: { accept: 'application/json' } });
          const j = await r.json().catch(() => ({}));
          if (j.status === 'invalid') say(hi ? 'कृपया सही ईमेल पता डालें।' : 'Please enter a valid email address.');
          else if (j.status === 'confirmed') say(hi ? 'आप पहले से सब्सक्राइब हैं।' : 'You are already subscribed.');
          else if (r.ok) { say(hi ? 'अपना ईमेल देखें: पुष्टि का लिंक भेजा है।' : 'Check your inbox: we have sent a confirmation link.'); f.reset(); }
          else say(hi ? 'अभी सब्सक्राइब नहीं हो सका। थोड़ी देर बाद कोशिश करें।' : 'Could not subscribe right now. Please try again later.');
        } catch { say(hi ? 'अभी सब्सक्राइब नहीं हो सका। थोड़ी देर बाद कोशिश करें।' : 'Could not subscribe right now. Please try again later.'); }
        if (btn) btn.disabled = false;
      });
    });
  </script>
  <div class="ck" id="ck" role="region" aria-label={lang === 'hi' ? 'कुकीज़' : 'Cookies'} hidden>
    <p>{lang === 'hi'
      ? <>हम यह समझने के लिए कुकीज़ इस्तेमाल करते हैं कि कौन-सी खबरें पढ़ी जाती हैं। विज्ञापन वाली कुकीज़ नहीं। <a href={`${p}/privacy/#cookies`}>और जानें</a></>
      : <>We use cookies to understand which stories are read. No advertising cookies. <a href={`${p}/privacy/#cookies`}>Learn more</a></>}</p>
    <div class="ckb"><button type="button" data-ck="no">{lang === 'hi' ? 'मना करें' : 'Decline'}</button><button type="button" class="ok" data-ck="yes">{lang === 'hi' ? 'स्वीकार करें' : 'Accept'}</button></div>
  </div>
  <script is:inline>
    (function () {
      var box = document.getElementById('ck'); if (!box) return;
      var get = function () { try { return localStorage.getItem('lv-cookies'); } catch (e) { return null; } };
      var set = function (v) { try { localStorage.setItem('lv-cookies', v); } catch (e) {} };
      if (!get()) box.hidden = false;
      box.addEventListener('click', function (e) {
        var b = e.target.closest('[data-ck]'); if (!b) return;
        set(b.getAttribute('data-ck')); box.hidden = true;
        if (b.getAttribute('data-ck') === 'yes' && window.lvLoadGA) window.lvLoadGA();
      });
      document.querySelectorAll('[data-cookie-settings]').forEach(function (a) {
        a.addEventListener('click', function (e) { e.preventDefault(); box.hidden = false; });
      });
    })();
  </script>
</body>
</html>
