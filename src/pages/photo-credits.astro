---
// Credits and licences for every photo used on the site (required by the Creative Commons licences).
import Base from '../layouts/Base.astro';
import PHOTOS from '../../content/photos.map.json';
const seen = new Map<string, any>();
for (const p of Object.values(PHOTOS as Record<string, any>)) if (!seen.has(p.id)) seen.set(p.id, p);
const list = [...seen.values()];
---
<Base lang="en" title="Photo credits" description="Credits and licences for the photographs used on Gandhi News." path="/photo-credits/" altPath={null}>
  <div class="w">
    <div class="ph-page" style="max-width:860px">
      <h1>Photo credits</h1>
      <p>We thank the photographers whose work appears on Gandhi News. Each photo below is used under the licence shown, and links to its original page.</p>
      <ul class="pc-list">
        {list.map((p) => (
          <li id={p.id}>
            <img src={p.src} alt={p.alt} loading="lazy" />
            <div><b>{p.alt}</b>{p.credit.replace(/^Photo:\s*/, '')}. Licence: {p.licence}. <a href={p.page} rel="noopener" target="_blank">Original</a></div>
          </li>
        ))}
      </ul>
    </div>
  </div>
</Base>
