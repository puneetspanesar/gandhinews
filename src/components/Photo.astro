---
// Photo slot. Order of preference:
//   1. a photo fetched by scripts/fetch-photos.mjs (content/photos.map.json, keyed by article id),
//   2. frontmatter hero.src (+ hero.credit),
//   3. a flat placeholder with a camera icon (and a caption on large slots).
import Icon from './Icon.astro';
import type { Lang } from '../lib/i18n';
import { UI } from '../lib/i18n';
import PHOTOS from '../../content/photos.map.json';
interface Props {
  /** Article id: looks up a fetched photo in content/photos.map.json. */
  id?: string;
  src?: string | null; alt?: string; credit?: string | null; caption?: string | null;
  size?: 'lg' | 'sm'; lang?: Lang; class?: string; eager?: boolean;
  /** Show the credit line over the image (large slots on the homepage). */
  showCredit?: boolean;
}
const { id, alt = '', size = 'sm', lang = 'en', class: cls = '', eager = false, showCredit = false } = Astro.props;
const fetched: any = id ? (PHOTOS as Record<string, any>)[id] : null;
const src = fetched?.src ?? Astro.props.src;
const srcset = fetched ? `${fetched.src800} 800w, ${fetched.src} 1600w` : undefined;
const credit = fetched ? `${fetched.credit}, ${fetched.licence}` : Astro.props.credit;
const altText = fetched ? ((lang === 'hi' ? fetched.alt_hi : fetched.alt) ?? alt) : alt;
const t = UI[lang];
---
{src ? (
  showCredit && credit ? (
    <span class={`photo ${cls}`}>
      <img src={src} srcset={srcset} sizes={size === 'lg' ? '(max-width: 700px) 100vw, 640px' : '160px'} alt={altText} loading={eager ? 'eager' : 'lazy'} decoding="async" width={fetched?.width} height={fetched?.height} />
      <span class="pcr">{credit}</span>
    </span>
  ) : (
    <img class={cls} src={src} srcset={srcset} sizes={size === 'lg' ? '(max-width: 700px) 100vw, 640px' : '160px'} alt={altText} loading={eager ? 'eager' : 'lazy'} decoding="async" width={fetched?.width} height={fetched?.height} />
  )
) : size === 'lg' ? (
  <div class={`ph lg ${cls}`} role="img" aria-label={alt}>
    <Icon name="camera" class="cam" />
    {alt && <span class="phc" aria-hidden="true">{t.photo}: {alt}</span>}
  </div>
) : (
  <div class={`ph ${cls}`} aria-hidden="true"><Icon name="camera" class="cam" /></div>
)}
