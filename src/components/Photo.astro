---
// Photo slot. Order of preference:
//   1. a picture registered in content/photos.map.json (keyed by article id),
//   2. frontmatter hero.src (+ hero.credit),
//   3. a flat placeholder with a camera icon (and a caption on large slots).
import Icon from './Icon.astro';
import type { Lang } from '../lib/i18n';
import { UI } from '../lib/i18n';
import PHOTOS from '../../content/photos.map.json';
interface Props {
  /** Article id: looks up a fetched photo in content/photos.map.json. */
  id?: string;
  src?: string | null; alt?: string; credit?: string | null; caption?: string | null;
  /** On a story page: an infographic story keeps its infographic instead of the collage. */
  story?: boolean;
  size?: 'lg' | 'sm'; lang?: Lang; class?: string; eager?: boolean;
  /** Show the credit line over the image (large slots on the homepage). */
  showCredit?: boolean;
  /** Use the story's 16:9 cover (people over the scene, headline) when it has one. Only for 16:9 slots. */
  cover?: boolean;
}
const { id, alt = '', size = 'sm', lang = 'en', class: cls = '', eager = false, showCredit = false, cover = false } = Astro.props;
const base: any = id ? (PHOTOS as Record<string, any>)[id] : null;
// A cover replaces the photo in 16:9 slots; it carries its own credit line through the base entry.
// Infographics: the detailed graphic only in large slots; small 16:9 slots get the readable thumb version.
const th: any = cover && base?.graphic && base?.thumb && size !== 'lg' ? (base.thumb[lang] ?? base.thumb.en) : null;
// The house collage treatment (newsroom/scripts/treat_photo.py, owner, November 9) replaces every photo everywhere,
// story pages included. Only a story page whose own visual is an infographic (story prop) keeps the infographic.
const tr: any = base?.treated ? { src: base.treated.src, src800: base.treated.src800, credit: base.treated.credit } : null;
const cv: any = th ?? tr ?? (cover && base?.cover ? (base.cover[lang] ?? base.cover.en) : null);
// Infographics carry a Hindi version of the card image too (base.byLang.hi).
const bl: any = !cv && base?.byLang?.[lang] ? { ...base, ...base.byLang[lang] } : null;
const fetched: any = cv ? { ...base, src: cv.src, src800: cv.src800, width: tr ? 1280 : base.cover.width, height: tr ? 800 : base.cover.height, ...(tr ? { credit: tr.credit, licence: '' } : {}) } : (bl ?? base);
const src = fetched?.src ?? Astro.props.src;
// Two widths exist for every fetched photo (640 and 1280); the browser picks by slot width and screen density.
const srcset = fetched?.src800 && fetched.src800 !== src ? `${fetched.src800} 640w, ${src} 1280w` : undefined;
// Large slots display at about 800 to 860px on desktop: ask for that, so the browser loads the 1280 file (not an upscaled 640).
const sizes = size === 'lg' ? '(max-width: 700px) 100vw, 860px' : '(max-width: 600px) 100vw, 320px';
// A detailed infographic is unreadable on a phone: phones get its thumb version (one figure, large type) instead.
const mob: any = size === 'lg' && base?.graphic && base?.thumb ? (base.thumb[lang] ?? base.thumb.en) : null;
const credit = fetched ? [fetched.credit, fetched.licence].filter(Boolean).join(', ') : Astro.props.credit;
const altText = fetched ? ((lang === 'hi' ? fetched.alt_hi : fetched.alt) ?? alt) : alt;
const t = UI[lang];
---
{src ? (
  showCredit && credit ? (
    <span class={`photo ${cls}`}>
      <picture>{mob && <source media="(max-width: 700px)" srcset={`${mob.src800} 640w, ${mob.src} 1280w`} sizes="100vw" />}<img src={src} srcset={srcset} sizes={sizes} alt={altText} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} decoding={eager ? 'sync' : 'async'} width={fetched?.width} height={fetched?.height} /></picture>
      <span class="pcr">{credit}</span>
    </span>
  ) : (
    mob ? <picture class={cls}><source media="(max-width: 700px)" srcset={`${mob.src800} 640w, ${mob.src} 1280w`} sizes="100vw" /><img src={src} srcset={srcset} sizes={sizes} alt={altText} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} decoding={eager ? 'sync' : 'async'} width={fetched?.width} height={fetched?.height} /></picture>
    : <img class={cls} src={src} srcset={srcset} sizes={sizes} alt={altText} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} decoding={eager ? 'sync' : 'async'} width={fetched?.width} height={fetched?.height} />
  )
) : size === 'lg' ? (
  <div class={`ph lg ${cls}`} role="img" aria-label={alt}>
    <Icon name="camera" class="cam" />
    {alt && <span class="phc" aria-hidden="true">{t.photo}: {alt}</span>}
  </div>
) : (
  <div class={`ph ${cls}`} aria-hidden="true"><Icon name="camera" class="cam" /></div>
)}
