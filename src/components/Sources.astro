---
import Icon from './Icon.astro';
import { UI, type Lang } from '../lib/i18n';
import { fmtDate } from '../lib/site';
import { resolveHref } from '../lib/routes.mjs';
interface Props { lang: Lang; sources: any[] }
const { lang, sources } = Astro.props;
const t = UI[lang];
const iconFor = (s: any) => (/\.pdf($|\?)/i.test(s.url || '') ? 'file-pdf' : s.primary ? 'file-text' : 'link-simple');
const dateText = (d: any) => (d instanceof Date ? fmtDate(d, lang) : d ? fmtDate(String(d), lang) : '');
---
{sources.length > 0 && (
  <section class="srcs" aria-labelledby="sources-h">
    <h2 id="sources-h">{t.sources}</h2>
    <ul>
      {sources.map((s) => (
        <li>
          <Icon name={iconFor(s)} />
          <div>
            {s.url && /^https?:/.test(s.url) ? <a href={s.url} rel="noopener" target="_blank">{s.title}</a> : s.url ? <a href={resolveHref(s.url, lang) ?? (() => { throw new Error(`Broken source link ${s.url}`); })()}>{s.title}</a> : s.title}
            <span>{[s.publisher, dateText(s.date)].filter(Boolean).join(', ')}</span>
          </div>
        </li>
      ))}
    </ul>
  </section>
)}
