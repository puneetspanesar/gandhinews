---
import Icon from './Icon.astro';
import { UI, type Lang } from '../lib/i18n';
import { urlOf } from '../lib/site';
interface Props { lang: Lang; topic: any; label?: string }
const { lang, topic } = Astro.props;
const t = UI[lang];
---
<section class="follow">
  <span class="k">{Astro.props.label ?? t.topic}</span>
  <h3>{topic.data.title}</h3>
  <p>{topic.data.standfirst}</p>
  {/* TODO(launch): "Follow this topic" should subscribe the reader to alerts for this topic (email or push)
      once a provider is chosen. Until then it opens the topic page. */}
  <a class="fbtn" href={urlOf(topic.data)} data-todo="topic-follow"><Icon name="bell-simple" />{t.followTopic}</a>
</section>
