---
// Gandhi News seal: the site icon, a white PT Serif "g" with the red square on black (November 8, 2026; was Google Sans).
import fs from 'node:fs';
import path from 'node:path';
import { ROOT } from '../lib/routes.mjs';
interface Props { small?: boolean }
const { small = false } = Astro.props;
const svg = fs.readFileSync(path.join(ROOT, 'src/components/seal.svg.txt'), 'utf8');
---
<span class={small ? 'seal sm' : 'seal'} set:html={svg} />
